{
  "_comment": [
    "HTTP contract between the Android app (app/.../data/LensApi.kt) and the backend (server/app.py).",
    "server/tests/test_api_contract.py checks the backend accepts these requests and returns exactly these response fields.",
    "app/src/test/.../data/LensApiContractTest.kt checks the app sends these requests and parses these responses.",
    "Change this file, the backend and the app together."
  ],
  "endpoints": {
    "describe": {
      "method": "POST",
      "path": "/describe",
      "multipartFields": ["image"],
      "response": {
        "sessionId": "4f7c1e0b9a2d4c6e8f1a3b5c7d9e0f12",
        "description": "باب أحمر عليه لافتة مكتوب عليها EXIT."
      }
    },
    "read": {
      "method": "POST",
      "path": "/read",
      "multipartFields": ["image"],
      "response": {
        "sessionId": "0a1b2c3d4e5f60718293a4b5c6d7e8f9",
        "contents": "Exit 12A\nKing Fahd Road"
      }
    },
    "chat": {
      "method": "POST",
      "path": "/chat",
      "multipartFields": ["image", "question"],
      "response": {
        "sessionId": "9f8e7d6c5b4a39281706f5e4d3c2b1a0",
        "answer": "الزر الأحمر في أعلى الشاشة."
      }
    },
    "followup": {
      "method": "POST",
      "path": "/followup",
      "jsonBody": {
        "sessionId": "4f7c1e0b9a2d4c6e8f1a3b5c7d9e0f12",
        "question": "ما لون الباب؟"
      },
      "response": {
        "answer": "الباب أحمر."
      }
    },
    "translate_text": {
      "method": "POST",
      "path": "/translate_text",
      "jsonBody": {
        "text": "Exit 12A is 300 meters ahead"
      },
      "response": {
        "answer": "المخرج 12A على بعد 300 متر."
      }
    }
  }
}
